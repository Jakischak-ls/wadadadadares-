-- MAKE KEY INDICATOR SQUARE AND SYMMETRICAL
---------------------------------------------------------
task.defer(function()
    task.wait(0.5)

    local gui =
        CoreGui:FindFirstChild("Obsidian")
        or CoreGui:FindFirstChild("Library")

    if not gui then
        return
    end

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextButton") and obj.Text == "M" then
            obj.Size = UDim2.fromOffset(26, 26)
            obj.AutomaticSize = Enum.AutomaticSize.None
            obj.TextXAlignment = Enum.TextXAlignment.Center
            obj.TextYAlignment = Enum.TextYAlignment.Center
        end
    end
end)

