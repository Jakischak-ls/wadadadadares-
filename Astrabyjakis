---------------------------------------------------------
-- ACCOUNT STATS & GREETING
---------------------------------------------------------
local userId = LocalPlayer.UserId

local headshotUrl = Players:GetUserThumbnailAsync(
    userId,
    Enum.ThumbnailType.HeadShot,
    Enum.ThumbnailSize.Size420x420
)

local accountAgeDays = LocalPlayer.AccountAge
local joinDateString = "Unknown"

pcall(function()
    local url = "https://users.roblox.com/v1/users/" .. tostring(userId)
    local response = HttpService:JSONDecode(game:HttpGet(url))

    if response and response.created then
        local year, month, day =
            response.created:match("(%d+)-(%d+)-(%d+)")

        if year and month and day then
            local months = {
                "Jan", "Feb", "Mar", "Apr",
                "May", "Jun", "Jul", "Aug",
                "Sep", "Oct", "Nov", "Dec"
            }

            joinDateString = string.format(
                "%s %s, %s",
                months[tonumber(month)] or "Jan",
                day,
                year
            )
        end
    end
end)

local function getGreeting()
    local hour = tonumber(os.date("!*t").hour) + 1

    if hour < 12 then
        return "Good Morning"
    elseif hour < 18 then
        return "Good Afternoon"
    else
        return "Good Evening"
    end
end

