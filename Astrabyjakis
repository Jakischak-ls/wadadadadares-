							localPlayer.PlayerScripts.StickyPartsTouchDetection.Disabled = arg
						end
					end)
				end,
			})

			defenseGroupbox:AddCheckbox("DefAntiLag", {
				Text = "Anti Lag",
				Default = false,
				Callback = function(arg)
					if arg then
						pcall(function()
							local ps = localPlayer:FindFirstChildOfClass("PlayerScripts")
							local cab = ps and ps:FindFirstChild("CharacterAndBeamMove")
							if cab then cab.Disabled = true end
						end)
					end
				end,
			})

			defenseGroupbox:AddCheckbox("DefAntiPaint", {
				Text = "Anti Paint",
				Default = false,
				Callback = function(arg)
					if arg then
						for _, obj in ipairs(Workspace:GetDescendants()) do
							if obj:IsA("BasePart") and obj.Name == "PaintPlayerPart" then
								obj:Destroy()
							end
						end
					end
				end,
			})

		end
	end
end

print("ASTRA script fixed and fully loaded!")
