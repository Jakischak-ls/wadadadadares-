local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

-- Load Library (Obsidian)
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

-- Configure Scheme
Library.Scheme.AccentColor = Color3.fromRGB(0, 122, 255)
Library.Scheme.BackgroundColor = Color3.fromRGB(12, 12, 12)
Library.Scheme.SidebarColor = Color3.fromRGB(255, 255, 255)
Library.Scheme.ButtonColor = Color3.fromRGB(124, 58, 237)
Library.Scheme.ButtonCornerRadius = UDim.new(0, 2)
Library.Scheme.ButtonCornerColor = Color3.fromRGB(0, 122, 255)
Library.Scheme.ButtonHoverColor = Color3.fromRGB(139, 92, 246)
Library.Scheme.TextColor = Color3.fromRGB(193, 205, 205)
Library.Scheme.SecondaryTextColor = Color3.fromRGB(193, 205, 205)

-- Create Main Window
local Window = Library:CreateWindow({
    Title = "ASTRA",
    Footer = "Made by Jakischak",
    Icon = "rbxassetid://104599341811828",
    Center = true,
    EnableCompacting = true,
    SidebarCompacted = true, -- Icon-only sidebar
    AutoShow = true,
    CornerRadius = 15,
})

-- Define Tabs (Image / Icon Only)
local Tabs = {
    MainTab = Window:AddTab("", "house"),
    PlayerTab = Window:AddTab("", "user"),
    GrabsTab = Window:AddTab("", "hand"),
    DefenseTab = Window:AddTab("", "shield"),
    AttackTab = Window:AddTab("", "swords"),
    AurasTab = Window:AddTab("", "sparkles"),
    ServerTab = Window:AddTab("", "server"),
    VisualTab = Window:AddTab("", "eye"),
    KeybindsTab = Window:AddTab("", "keyboard"),
    UiTab = Window:AddTab("", "settings"),
    CreditsTab = Window:AddTab("", "heart")
}

---------------------------------------------------------
-- HOME TAB (Profile Headshot & Info)
---------------------------------------------------------
local ProfileGroup = Tabs.MainTab:AddLeftGroupbox("Profile", "user")

-- Fetch local player headshot thumbnail
local userId = LocalPlayer.UserId
local headshotUrl = Players:GetUserThumbnailAsync(
    userId,
    Enum.ThumbnailType.HeadShot,
    Enum.ThumbnailSize.Size420x420
)

-- Display Headshot Image
ProfileGroup:AddImage("ProfileHeadshot", {
    Image = headshotUrl,
    Height = 150,
})

ProfileGroup:AddLabel("User: " .. LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")")
ProfileGroup:AddLabel("User ID: " .. tostring(userId))
ProfileGroup:AddDivider()
ProfileGroup:AddLabel("Made by Jakischak")

---------------------------------------------------------
-- ACTIONS GROUPBOX
---------------------------------------------------------
local ActionsGroup = Tabs.MainTab:AddRightGroupbox("Actions", "star")

ActionsGroup:AddButton({
    Text = "Unload Astra Hub",
    Func = function()
        Library:Unload()
    end
})

ActionsGroup:AddButton({
    Text = "Rejoin Server",
    Func = function()
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end
})

ActionsGroup:AddButton({
    Text = "Copy Discord Link",
    Func = function()
        setclipboard("https://discord.gg/sunc")
    end
})

-- Enlarge custom header logo
task.spawn(function()
    task.wait(0.5)
    pcall(function()
        local gui = CoreGui:FindFirstChild("Obsidian") or CoreGui:FindFirstChild("Library")
        if gui then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc:IsA("ImageLabel") and desc.Image == "rbxassetid://104599341811828" then
                    desc.Size = UDim2.new(0, 48, 0, 48)
                end
            end
        end
    end)
end)

print("ASTRA UI Loaded with Profile Headshot & Made by Jakischak.")
