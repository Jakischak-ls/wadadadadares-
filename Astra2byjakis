local origGetCustomIcon = lib.GetCustomIcon
lib.GetCustomIcon = function(self, iconName, arg2)
	local candidate = arg2 ~= nil and arg2 or iconName
	if type(candidate) == "number" or tonumber(candidate) then
		return {
			Url = string.format("rbxthumb://type=Asset&id=%.0f&w=150&h=150", tonumber(candidate)),
			ImageRectOffset = Vector2.zero,
			ImageRectSize = Vector2.zero,
			Custom = nil,
		}
	end
	if type(origGetCustomIcon) == "function" then
		return origGetCustomIcon(self, candidate)
	end
	return nil
end

