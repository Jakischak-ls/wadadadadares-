function obsidianThemeManager:SetLibrary(library)
	self.Library = library
end

function obsidianThemeManager:GetPaths()
	local paths = {}
	local parts = self.Folder:split("/")
	for i = 1, #parts do
		paths[#paths + 1] = table.concat(parts, "/", 1, i)
	end
	paths[#paths + 1] = self.Folder .. "/themes"
	return paths
end

function obsidianThemeManager:BuildFolderTree()
	if not hasFs then return end
	for _, path in ipairs(self:GetPaths()) do
		if not isfolder(path) then
			pcall(makefolder, path)
		end
	end
end

function obsidianThemeManager:ApplyTheme(themeName)
	local themeEntry = self.BuiltInThemes[themeName]
	if not themeEntry then return end
	local colors = themeEntry[2]
	for k, v in pairs(colors) do
		if k == "FontFace" then
			pcall(function() self.Library:SetFont(Enum.Font[v]) end)
			if self.Library.Options[k] then
				pcall(function() self.Library.Options[k]:SetValue(v) end)
			end
		else
			local col = Color3.fromHex(v)
			self.Library.Scheme[k] = col
			if self.Library.Options[k] then
				pcall(function() self.Library.Options[k]:SetValueRGB(col) end)
			end
		end
	end
	self:ThemeUpdate()
end

function obsidianThemeManager:ThemeUpdate()
	for _, field in ipairs(themeFields) do
		if self.Library.Options and self.Library.Options[field] then
			self.Library.Scheme[field] = self.Library.Options[field].Value
		end
	end
	if self.Library.UpdateColorsUsingRegistry then
		self.Library:UpdateColorsUsingRegistry()
	end
end

obsidianThemeManager:BuildFolderTree()
